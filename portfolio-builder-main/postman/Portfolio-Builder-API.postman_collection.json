{
  "info": {
    "name": "Portfolio Builder API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD tests for the Portfolio Builder REST API (GET, POST, PUT, PATCH, DELETE). Select an environment (Local or Render), then run the collection in order with the Collection Runner."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "username",
      "value": "pmtester"
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "description": "Run first.",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response time < 3000 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(3000); });",
                  "pm.test(\"Content-Type is JSON\", function () { pm.response.to.have.header(\"Content-Type\"); pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"status is ok\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Generate unique username",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"username\", \"pm\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response time < 3000 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(3000); });",
                  "console.log(\"username =\", pm.collectionVariables.get(\"username\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Run this first: creates a unique {{username}} so the collection can be re-run without 409 conflicts."
          }
        }
      ]
    },
